{
	"name": "api",
	"version": "1.0.0",
	"main": "index.js",
	"scripts": {
		"start": "ts-node-dev ./src/index.ts",
		"production": "node ./build/index.js",
		"build": "tsc",
		"knex:rollback-all": "knex --knexfile ./src/database/knex/Environment.ts migrate:rollback --all",
		"knex:rollback": "knex --knexfile ./src/database/knex/Environment.ts migrate:rollback",
		"knex:migrate": "knex --knexfile ./src/database/knex/Environment.ts migrate:latest",
		"knex:seed": "knex --knexfile ./src/database/knex/Environment.ts seed:run",
		"test": "jest",
		"doc": "node src/swagger.js"
	},
	"license": "ISC",
	"dependencies": {
		"bcryptjs": "^2.4.3",
		"cors": "^2.8.5",
		"dotenv": "^16.4.5",
		"express": "^4.19.2",
		"http-status-codes": "^2.3.0",
		"jimp": "^0.22.12",
		"jsonwebtoken": "^9.0.2",
		"knex": "^3.1.0",
		"multer": "^1.4.5-lts.1",
		"sqlite3": "^5.1.7",
		"swagger-autogen": "^2.23.7",
		"swagger-ui-express": "^5.0.1",
		"yup": "^1.4.0"
	},
	"devDependencies": {
		"@types/bcryptjs": "^2.4.2",
		"@types/cors": "^2.8.17",
		"@types/express": "^4.17.21",
		"@types/jsonwebtoken": "^8.5.8",
		"@types/multer": "^1.4.11",
		"@types/swagger-ui-express": "^4.1.6",
		"ts-node-dev": "^2.0.0",
		"typescript": "^5.5.4"
	}
}
